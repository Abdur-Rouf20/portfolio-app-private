# Legacy/root-level environment template. Backend configuration should live in backend/.env.
# Keep this file free of real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_db
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
PORTFOLIO_NOTIFICATION_EMAIL=your-email@example.com
