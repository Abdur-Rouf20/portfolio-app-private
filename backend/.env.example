# Copy to backend/.env and fill in your own values.
# Never commit backend/.env or put real credentials in this template.
NODE_ENV=development
PORT=5500

# MongoDB Atlas or local MongoDB connection string.
# The application accepts MONGODB_URI (preferred) or legacy MONGO_URI.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Frontend origin. For multiple origins, separate them with commas.
CLIENT_ORIGIN=http://localhost:5173

# Used only by the seed script to create the first admin account.
ADMIN_NAME=Portfolio Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_characters

# Optional SMTP settings for contact-form email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
PORTFOLIO_NOTIFICATION_EMAIL=your-email@example.com
